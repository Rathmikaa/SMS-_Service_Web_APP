# Copy this file to .env for local runs (or set these as env vars in your host's dashboard)

# Flask
SECRET_KEY=change-me-to-something-random
FLASK_DEBUG=0
PORT=5000

# Where the SQLite DB file lives (use a persistent disk path in production)
DB_PATH=./data/app.db

# --- SMS provider selection ---
# console  = safe default, just logs what would be sent, never actually sends
# textbee  = https://textbee.dev      (turns an Android phone into an SMS
#            gateway, no per-message fee, no DLT hoops — get your API key
#            and device ID from https://app.textbee.dev/dashboard)
# fast2sms = https://www.fast2sms.com  (India, free trial credits)
# msg91    = https://msg91.com        (India, free trial credits)
# twilio   = https://www.twilio.com   (global, free trial credit but can only
#            text numbers you've verified in the Twilio console until upgraded)
SMS_PROVIDER=console

# --- TextBee ---
# 1. Install the TextBee app on an Android phone and sign in.
# 2. Open https://app.textbee.dev/dashboard, register the device, and copy
#    the API key + device ID shown there.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# --- Fast2SMS ---
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
FAST2SMS_SENDER_ID=
FAST2SMS_DLT_TEMPLATE_ID=

# --- MSG91 ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=GCCTAX
MSG91_ROUTE=4

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
